  "derivation": {
    "voltage": "Platform Kconfig selects SVI2/SVI3; each helper reads the P-state union fields, not a sensor register. SVI2 off >=F8h; SVI3 off zero; otherwise integer microvolt arithmetic.",
    "current": "Independent current divisor 1/10/100 is inferred algebraically from the pinned ACPI _PSS power routine: microvolts / 10 * IddValue, then divide by 100/1000/10000 to obtain milliwatts. IddDiv 3 is explicitly undefined.",
    "scope": "AMD OSRR 56255 Rev 3.03 page 130 identifies Idd as expected maximum single-core current for ACPI _PSS. That page does not itself specify divisor values."
  },
  "not_enabled": {
    "phoenix": "Inspected MSR header retains TODO: Update for Phoenix; not enough independent evidence in this batch.",
    "genoa": "Inspected files do not establish the complete voltage helper selection in this batch.",
    "other_models": "No family-wide inference; includes all 1Ah and other 17h/19h models."
  },
  "restrictions": [
    "No hardware writes or measured voltage/current claims.",
    "Virtualized CPU, disabled definition, reserved high bits: no electrical values.",
