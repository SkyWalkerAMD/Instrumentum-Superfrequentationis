obj-m := octool_hwio.o
clean-files += .octool-class-1.log .octool-class-2.log

# Kbuild also includes this file from Makefile.clean without a compiler setup.
ifeq ($(filter Makefile.clean %/Makefile.clean,$(MAKEFILE_LIST)),)
# Compile with this kernel's flags and generated headers, including Debian's
# split common/architecture headers. Never infer this API from kernel versions.
# Makefile.lib normally adds these per-object flags after including this file.
# A parse-time probe must supply the same compiler header and module context.
pk-probe-flags = $(NOSTDINC_FLAGS) $(LINUXINCLUDE) \
    -include $(srctree)/include/linux/compiler_types.h \
    $(KBUILD_CPPFLAGS) $(KBUILD_CFLAGS) $(KBUILD_CFLAGS_MODULE) $(CFLAGS_MODULE) \
    -DMODULE -DKBUILD_MODNAME='"octool_hwio"' -D__KBUILD_MODNAME=kmod_octool_hwio \
    -DKBUILD_BASENAME='"octool_probe"'
# A real source file avoids GNU Make's differing treatment of escaped '#' in
# function arguments. The probe is compile-only and never linked into the ko.
pk-class-probe = $(call try-run,$(CC) $(pk-probe-flags) $(1) -Werror -x c -c -o "$$TMP" "$(src)/class_create_probe.c" 2>"$(obj)/.octool-class-$(2).log",y,n)
PK_CLASS_CREATE_ONE := $(call pk-class-probe,-DPK_CLASS_CREATE_PROBE_ONE_ARG,1)
ifeq ($(PK_CLASS_CREATE_ONE),y)
ccflags-y += -DPK_CLASS_CREATE_1ARG
$(info octool: class_create(name) probe passed)
else
PK_CLASS_CREATE_TWO := $(call pk-class-probe,,2)
ifneq ($(PK_CLASS_CREATE_TWO),y)
$(shell cat "$(obj)/.octool-class-1.log" "$(obj)/.octool-class-2.log" >&2)
$(error octool: neither class_create signature compiles; check CC and complete configured kernel headers)
endif
$(info octool: class_create(owner, name) probe passed)
endif
endif
